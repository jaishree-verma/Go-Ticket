# GoTicket Environment Configuration Template
# Copy this file to .env.local or .env for custom overrides.

# Application Environment
REACT_APP_ENV=development
REACT_APP_APP_NAME=GoTicket

# Backend API Configuration (Optional - for future FastAPI / MySQL integration)
# When unset or commented, GoTicket operates in full standalone offline/mock mode
REACT_APP_API_URL=http://localhost:8000/api/v1

# Mapbox / Location Services (Optional - for enhanced live bus telemetry)
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_token_here

# AI Agent Configuration
REACT_APP_AGENT_NAME=Tixie
REACT_APP_ENABLE_NOTIFICATION_DEMO=true
REACT_APP_DEFAULT_PAYMENT_MODE=DEMO
